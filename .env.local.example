# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Secret (자동 크롤링 인증용)
CRON_SECRET=your-secret-key

# OpenAI (챗봇 답변 + 임베딩 + 게시물 분석/요약)
OPENAI_API_KEY=sk-...

# 챗봇 검색 모드: true=Agentic RAG (function calling), 미설정=Vanilla RAG
CHAT_AGENTIC_RAG=true

# ── 임베딩 공급자 ──────────────────────────────────────────────
# openai(기본) | ollama
# 두 모델은 벡터 공간이 다르므로 전환하면 전체 재임베딩이 필수:
#   npx tsx scripts/reembed-posts.ts --execute
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small   # 기본값 (dimensions=1024로 축소)
# OLLAMA_EMBED_MODEL=bge-m3                   # ollama일 때 사용

# ── 게시물 분석/요약 공급자 ────────────────────────────────────
# LLM_ENABLED: 마스터 스위치. false면 categorizer.ts 키워드 폴백으로 동작.
# LLM_PROVIDER: openai(기본) | ollama. 임베딩과 달리 재생성 없이 즉시 전환 가능.
#   - openai → 로컬 GPU 불필요. 이미지 공지(CLOVA OCR) 경로도 함께 동작.
#   - ollama → OLLAMA_MODEL 필수 (env.ts에서 검증).
LLM_ENABLED=true
LLM_PROVIDER=openai
# OPENAI_LLM_MODEL=gpt-4o-mini   # 기본값
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M

# ── 이미지 공지 OCR (선택) ─────────────────────────────────────
# 네이버 클라우드 API라 로컬 GPU와 무관. 미설정 시 이미지 공지는 안내 문구로 저장.
# CLOVA_OCR_URL=https://...
# CLOVA_OCR_SECRET=...
